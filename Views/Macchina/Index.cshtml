@model List<MacchinaViewModel>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">Identificativo</th>
                <th scope="col">Numero ruote</th>
                <th scope="col">Alimentazione</th>
                <th scope="col">Categoria</th>
                <th scope="col">Colore</th>
                <th scope="col">Marca</th>
                <th scope="col">Anno produzione</th>
                <th scope="col">Modello</th>
                <th scope="col">Targa</th>
                <th scope="col">Cilindrata (cc)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var macchina in Model)
            {
                <tr>
                    <td>MA-@macchina.VeicoloId</td>
                    <td>@macchina.NumeroRuote</td>
                    <td>@macchina.TipoAlimentazione.Nome</td>
                    <td>@macchina.Categoria.Nome</td>
                    <td>@macchina.Colore</td>
                    <td>@macchina.Marca</td>
                    <td>@macchina.AnnoProduzione</td>
                    <td>@macchina.Modello</td>
                    <td>@macchina.Targa</td>
                    <td>@macchina.Cc</td>
                </tr>
            }
        </tbody>
    </table>
</div>